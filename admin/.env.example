# Admin panel environment (Vite — only VITE_-prefixed vars reach the client).
# Copy to .env for local development. See docs/00 §10 for the canonical list.

VITE_API_URL=http://localhost:4000/api/v1
# S3/CDN base for media assets (avatars). Empty → falls back to the API origin.
VITE_CDN_URL=
VITE_SENTRY_DSN=
VITE_APP_ENV=development

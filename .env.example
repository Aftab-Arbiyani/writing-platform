# ─────────────────────────────────────────────────────────────────────────────
# Compose-level environment (consumed by docker-compose.yml).
# Application-level env vars (DATABASE_URL, JWT_*, S3_*, …) live in each
# workspace's own .env.example — this file only configures dev infrastructure.
# Copy to .env and adjust as needed. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=qalam
POSTGRES_PASSWORD=qalam
POSTGRES_DB=qalam

MINIO_ROOT_USER=qalam
MINIO_ROOT_PASSWORD=qalamqalam

# Host-side port bindings — override when a local daemon already owns the
# canonical port (keep backend/.env DATABASE_URL / REDIS_URL in sync).
#POSTGRES_PORT=5432
#REDIS_PORT=6379
#MINIO_PORT=9000
#MINIO_CONSOLE_PORT=9001
#MAILPIT_SMTP_PORT=1025
#MAILPIT_UI_PORT=8025

{
  "name": "@qalam/ui",
  "version": "0.1.0",
  "description": "Qalam design tokens (--q-*), AntD theme factory, and shared primitives (Phase 1).",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/tailwind.css": "./styles/tailwind.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "antd": "^5.21.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@qalam/config": "workspace:*",
    "@types/react": "^19.0.0",
    "antd": "^5.21.0",
    "eslint": "^9.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "clsx": "^2",
    "framer-motion": "^12",
    "lucide-react": "^0.468",
    "tailwind-merge": "^3"
  }
}

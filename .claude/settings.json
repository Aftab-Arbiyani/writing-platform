{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm format:check:*)",
      "Bash(pnpm --filter * lint:*)",
      "Bash(pnpm --filter * typecheck:*)",
      "Bash(pnpm --filter * test:*)",
      "Bash(pnpm --filter * build:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Grep",
      "Glob",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(fd:*)",
      "Bash(pnpm exec jest:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(npx jest:*)",
      "Bash(npx vitest:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-rules.sh\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-changed.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-tests.sh\""
          }
        ]
      }
    ]
  }
}

# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Turborepo cache
.turbo/

# Test coverage
coverage/

# Environment files (the example is the documented shape and stays tracked)
.env
.env.*
!.env.example

# OS / misc
.DS_Store
logs/

# Claude Code hook scratch state. The changed-files tracker writes one of these wherever a
# hook happens to fire, so it appears at many depths (repo root, e2e/, frontend/src/, …) —
# hence the any-depth pattern. The rest of .claude/ (hooks, settings, README) stays tracked;
# personal overrides are handled by .claude/.gitignore.
**/.claude/state/

# Playwright E2E (saved sessions + run artifacts + local stack state)
e2e/.auth/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.stack/
# TEMPORARY (48 §3.18b): drain target for the action-menu diagnostic. Goes with the fix.
e2e/.diag/

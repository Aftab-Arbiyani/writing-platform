# ══════════════════════════════════════════════════════════════════════════
# Qalam backend environment — dev defaults match the docker-compose infra
# profile. Copy with `cp .env.example .env`. Every variable is validated at
# boot by src/config/env.schema.ts (Zod, fail-fast).
# ══════════════════════════════════════════════════════════════════════════

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ── Public URLs (frontend 5173, admin 5174 — these two form the CORS
#    allowlist; ADMIN_URL supplements the ADR §10 list for that purpose) ─────
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:4000

# ── PostgreSQL 16 (compose: db qalam, user qalam) ───────────────────────────
DATABASE_URL=postgresql://qalam:qalam@localhost:5432/qalam

# ── Redis 7 — one instance, logical DBs: 0 cache · 1 queues · 2 rate-limit ·
#    3 auth (refresh rotation / denylist) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (access 15 min + rotating refresh 30 days) ──────────────────────────
# SECURITY: generate real secrets with `openssl rand -base64 32`. The values
# below are dev-only placeholders so a fresh checkout boots.
JWT_ACCESS_SECRET=dev-only-placeholder-generate-via-openssl-rand-base64-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-only-placeholder-generate-via-openssl-rand-base64-32
JWT_REFRESH_TTL=30d

# ── Google OAuth (leave empty until Phase 1 auth wires the provider) ────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Bootstrap super-admin (seeded by `pnpm seed`, after migrations) ─────────
# The first super_admin account, created idempotently by the seed runner. In
# DEVELOPMENT these default to admin@qalam.local / superadmin / a dev password
# (a warning tells you to change it). In PRODUCTION the seed REFUSES to create a
# default-credential admin: set ALL THREE below or the super-admin step is
# skipped. The password is argon2id-hashed (same policy as registration, 10–128
# chars, not a common password) and never logged; re-running only ensures the
# role (it never resets a rotated password).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# ── Object storage — MinIO in dev (console http://localhost:9001),
#    S3/R2 in production ──────────────────────────────────────────────────────
# Access/secret must match the compose MinIO root creds (MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD in the root .env — default qalam / qalamqalam).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=qalam-media
S3_ACCESS_KEY=qalam
S3_SECRET_KEY=qalamqalam

# ── Mail — Mailpit in dev (SMTP 1025, web UI http://localhost:8025) ─────────
SMTP_URL=smtp://localhost:1025

# ── Observability (empty disables Sentry — fine for local dev) ──────────────
SENTRY_DSN=
# Trace sampling (docs 14 §2.3) and the release tag (usually the git sha, set by CI).
SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=          # falls back to GIT_SHA
# GIT_SHA=                 # injected at build/deploy for release correlation

# Pretty (human) logs. Default on in development; MUST be false in production
# (structured JSON only — enforced by the env schema on the production tier).
# LOG_PRETTY=false
# Fraction of info/debug logs a downstream collector should keep (1 = all).
# Emitted as a hint on every line; errors/warns are never dropped. Log-sampling hook.
# LOG_SAMPLE_RATE=1

# ══════════════════════════════════════════════════════════════════════════
# Build / deployment metadata (P7.1) — single source of truth for /version,
# /admin/system/info, structured-log bindings and Sentry tags. Injected by the
# image build / CD pipeline (baked into the image via Docker ARGs). All optional
# so local dev + tests boot without them.
# ══════════════════════════════════════════════════════════════════════════
SERVICE_NAME=qalam-backend
# APP_VERSION=1.4.2           # semver / release tag
# GIT_SHA=                    # full commit sha (release correlation)
# BUILD_TIME=                 # ISO-8601 build timestamp
# BUILD_NUMBER=               # CI run/build number
# RELEASE_CHANNEL=dev         # stable | rc | beta | canary | dev
# DEPLOYED_AT=                # ISO-8601 deploy timestamp (set by the deploy script)
# INSTANCE_ID=                # orchestrator-provided; defaults to <hostname>:<pid>

# ══════════════════════════════════════════════════════════════════════════
# Secret injection (P7.1) — container/file-mounted secrets. For any variable
# FOO you may instead set FOO_FILE=/run/secrets/foo (Docker/K8s secret files);
# the file's contents are loaded into FOO before validation, and an explicitly
# set FOO always wins. Alternatively point SECRETS_DIR at a directory whose
# filenames are env-var names (Docker/K8s default mount layout).
# Examples:
#   JWT_ACCESS_SECRET_FILE=/run/secrets/jwt_access
#   DATABASE_URL_FILE=/run/secrets/database_url
#   SECRETS_DIR=/run/secrets

# ── Production hardening (Epic 12 + P7.1) — all optional, safe defaults ───────
# Trusted reverse-proxy hop count (nginx/LB). >0 enables X-Forwarded-* trust so
# client IPs, secure cookies and protocol detection are correct behind an edge.
TRUST_PROXY_HOPS=0
# Optional read-replica DSN (replication-ready seam). Empty = single node; when
# set, TypeORM routes reads to the replica and writes to DATABASE_URL.
# DATABASE_REPLICA_URL=
# Public CDN origin for media (empty = clients build URLs from S3_ENDPOINT).
# CDN_URL=
# Presigned-URL lifetime (seconds) for the signed-URL seam.
S3_SIGNED_URL_TTL_SECONDS=900
# From header on outbound mail.
MAIL_FROM=Qalam <no-reply@qalam.local>

# ── Production hardening (Epic 12) — all optional, safe defaults ─────────────
# Prometheus scrape auth for GET /metrics. Empty = open (dev); set in prod
# (also IP-allowlist /metrics at the edge). Bearer token or ?token=.
METRICS_TOKEN=
# Master switch for the global rate-limit guard. Set false for load tests only.
RATE_LIMIT_ENABLED=true
# Postgres connection pool (size against PG max_connections ÷ instance count).
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=10000

# ══════════════════════════════════════════════════════════════════════════
# Async processing — BullMQ queues / workers / scheduler / cache (Epic 11)
# All optional with sensible defaults (read directly from process.env in
# src/config/infrastructure.config.ts — not part of the Zod schema, like the
# TRENDING_* knobs). Shown here for discoverability.
# ══════════════════════════════════════════════════════════════════════════

# Master switches — run an API-only node (WORKERS_ENABLED=false) or disable the
# cron registration (SCHEDULER_ENABLED=false, useful in CI/one-off scripts).
WORKERS_ENABLED=true
SCHEDULER_ENABLED=true

# Cron schedules (standard 5-field). Defaults shown.
CRON_SCHEDULED_PUBLISH=* * * * *
CRON_TRENDING_RECOMPUTE=0 * * * *
CRON_ANALYTICS_SNAPSHOT=0 * * * *
CRON_ANALYTICS_ROLLUP=0 3 * * *
CRON_DAILY_CLEANUP=0 4 * * *
CRON_WEEKLY_DB_MAINTENANCE=0 5 * * 0
CRON_CACHE_OPTIMIZE=30 5 * * 0
CRON_CACHE_WARM=*/15 * * * *

# Per-queue overrides (optional). Pattern: QUEUE_<NAME>_<KNOB> where <NAME> is
# the queue name upper-cased with '-' → '_'. Knobs: _CONCURRENCY, _ATTEMPTS,
# _BACKOFF_MS, _PRIORITY, _KEEP_COMPLETED, _KEEP_FAILED. Examples:
# QUEUE_NOTIFICATIONS_CONCURRENCY=5
# QUEUE_MEDIA_PROCESSING_CONCURRENCY=2
# QUEUE_TRENDING_SCORE_ATTEMPTS=1

# Cache TTLs (seconds) for the warm/refresh jobs, and the stampede-lock TTL.
CACHE_TTL_TRENDING=300
CACHE_TTL_FEATURED=900
CACHE_TTL_ANALYTICS=300
CACHE_STAMPEDE_LOCK_TTL=10

# Maintenance retention windows (days).
RETENTION_EXPIRED_TOKEN_DAYS=1
RETENTION_NOTIFICATION_DAYS=365
RETENTION_SOFT_DELETE_DAYS=30

# ══════════════════════════════════════════════════════════════════════════
# Performance & Scalability Platform (P7.3)
# All optional with sensible defaults (src/config/performance.config.ts, not in
# the Zod schema). The platform measures HTTP/cache/queue/DB via one observer
# seam and verifies live telemetry against the centralized budget catalogue.
# ══════════════════════════════════════════════════════════════════════════

# Master switch — PERF_ENABLED=false makes the registry ignore samples (0 cost).
PERF_ENABLED=true
# Slow-query threshold (ms) → TypeORM maxQueryExecutionTime; 0 disables capture.
PERF_SLOW_QUERY_MS=200
# Rolling analysis window (seconds) for throughput/rate math.
PERF_WINDOW_SECONDS=300
# Event-loop-lag sampler resolution hint (ms); 0 disables the sampler.
PERF_EVENT_LOOP_SAMPLE_MS=2000
# Deterministic benchmarks (admin read + CLI runner).
PERF_BENCHMARK_ENABLED=true
PERF_BENCHMARK_ITERATIONS=2000
# Capacity ceilings — 0 keeps the documented single-VM default (docs 43 §11).
PERF_CAP_API_RPS=0
PERF_CAP_WORKERS=0
PERF_CAP_REDIS_MEMORY_BYTES=0
PERF_CAP_AI_TOKENS_DAILY=0

# ══════════════════════════════════════════════════════════════════════════
# Operations Platform (P7.4)
# All optional with sensible defaults (src/config/operations.config.ts, not in
# the Zod schema). The single source of truth for operating in production —
# observability, SLOs, alerting, incidents, deployment/cost observability,
# feature rollout, reliability, and governance. Reuses the Performance/Security/
# Infrastructure platforms; durable ops state = durable Redis + audit trail.
# ══════════════════════════════════════════════════════════════════════════

# Master switch — OPS_ENABLED=false makes the registry ignore signals (0 cost).
OPS_ENABLED=true
# Distributed tracing — head sampling fraction + bounded in-memory trace store.
OPS_TRACE_SAMPLE_RATE=0.1
OPS_TRACE_BUFFER_SIZE=200
OPS_TRACE_MAX_SPANS=100
# Structured-logging policy (mirrors LOG_SAMPLE_RATE) + documented retention.
OPS_LOG_RETENTION_DAYS=30
# SLO window (seconds, default 30d) + burn-rate thresholds (fast/slow).
OPS_SLO_WINDOW_SECONDS=2592000
OPS_SLO_FAST_BURN=14.4
OPS_SLO_SLOW_BURN=3
# Alerting — dedup/suppression window + fired-alert retention (seconds).
OPS_ALERT_DEDUP_SECONDS=300
OPS_ALERT_RETENTION_SECONDS=604800
# Incident + deployment retention / history size.
OPS_INCIDENT_RETENTION_SECONDS=7776000
OPS_DEPLOY_HISTORY_SIZE=100
# Cost estimate rates (internal estimate, never a bill of record).
OPS_COST_AI_PER_MTOK_USD=6
OPS_COST_STORAGE_PER_GIB_USD=0.023
OPS_COST_BANDWIDTH_PER_GIB_USD=0.09
OPS_COST_INFRA_MONTHLY_USD=120

# ══════════════════════════════════════════════════════════════════════════
# AI providers (AF1) — src/config/ai.config.ts
# Every provider is CREDENTIAL-GATED: a provider with no key is inert, and the
# AI module refuses rather than no-ops. Names are listed here with EMPTY values
# on purpose — this file is the annotated index `docs/19 §3` points at, and a
# knob that is absent from it is a knob nobody knows exists (48 §3.22b, AI-4).
# Never commit a real key; production values come from the secret platform
# (docs/40), not from a checked-in file.
# ══════════════════════════════════════════════════════════════════════════

# Which provider serves a request when the caller does not name one, and the
# model to use (blank => the model registry picks that provider's default).
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=
# Per-request stream timeout, and the platform-wide token allowances. These are
# the AI module's own ceilings — plan limits (AF5) are enforced separately.
#
# ⚠️ These carry their real defaults rather than being left blank, and must stay
# that way — empty is NOT "unset" for a numeric knob here. `ai.config.ts` reads
# raw `process.env` (`Number(process.env.X ?? DEFAULT)`) and `??` does not catch
# an empty string, so a blank yields `Number('') === 0`. The two limits then read
# as UNLIMITED, because `usage.service.ts` enforces only `if (limit > 0)` — a
# blank would switch the token cap OFF rather than apply the 100k default. The
# timeout fails differently and more kindly: `env.schema.ts` types it
# `.positive()`, so a blank dies at boot with one readable error instead.
AI_REQUEST_TIMEOUT_MS=60000
AI_DAILY_TOKEN_LIMIT=100000
AI_MONTHLY_TOKEN_LIMIT=2000000

# Adapters SHIPPED in AF1 (IMPLEMENTED_AI_PROVIDERS): openai, anthropic, google.
# A base URL is optional per provider — set it to point an OpenAI-compatible
# adapter at a different host with no code change.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=

# Reserved extension points — the provider enum accepts these and the config
# reads them, but NO adapter ships for them yet, so setting a key here does not
# make the provider work. Listed so the names are discoverable rather than
# found by reading the config (see 48 §3.22b AI-3 for the dead-export half).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
LM_STUDIO_API_KEY=
LM_STUDIO_BASE_URL=
SELF_HOSTED_AI_API_KEY=
SELF_HOSTED_AI_BASE_URL=

# The `stub` provider (StubAdapter) — streams one fixed passage instead of
# generating, so a stack with no vendor key can still exercise an AI flow. It
# holds no credential; this flag IS its gate. TEST STACKS ONLY: with
# AI_STUB_ENABLED=true and AI_DEFAULT_PROVIDER=stub, every writer's suggestion
# is the same canned paragraph (`e2e/scripts/stack-up.sh` sets both).
AI_STUB_ENABLED=false

# ══════════════════════════════════════════════════════════════════════════
# Payments / monetization (AF5) — src/config/payments.config.ts
# Same posture as AI: every real adapter is key-gated, so a stack with no
# credentials cannot complete a checkout. The monetization PLATFORM is gated
# separately by the `feature.payments.enabled` feature flag (admin-toggleable,
# dark by default) — these knobs only decide which processor can settle.
# ══════════════════════════════════════════════════════════════════════════

# Adapters SHIPPED in AF5 (IMPLEMENTED_PAYMENT_PROVIDERS): stripe, apple, google_play.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=
APPLE_VERIFY_URL=
APPLE_SANDBOX_VERIFY_URL=
# Sandbox receipts verify against a different Apple endpoint. `true` here MATCHES
# the code default (`?? 'true'`), so copying this file changes nothing; production
# is the deployment that must set it to false.
APPLE_USE_SANDBOX=true

GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_API_BASE_URL=

# The `manual` provider (ManualAdapter) — settles a charge with no processor
# behind it, so a test stack can assert subscribe → payment → entitlement end to
# end. OFF everywhere else, deliberately: it books revenue nobody collected.
PAYMENTS_MANUAL_ENABLED=false

# ══════════════════════════════════════════════════════════════════════════
# Qalam backend environment — dev defaults match the docker-compose infra
# profile. Copy with `cp .env.example .env`. Every variable is validated at
# boot by src/config/env.schema.ts (Zod, fail-fast).
# ══════════════════════════════════════════════════════════════════════════

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ── Public URLs (frontend 5173, admin 5174 — these two form the CORS
#    allowlist; ADMIN_URL supplements the ADR §10 list for that purpose) ─────
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:4000

# ── PostgreSQL 16 (compose: db qalam, user qalam) ───────────────────────────
DATABASE_URL=postgresql://qalam:qalam@localhost:5432/qalam

# ── Redis 7 — one instance, logical DBs: 0 cache · 1 queues · 2 rate-limit ·
#    3 auth (refresh rotation / denylist) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (access 15 min + rotating refresh 30 days) ──────────────────────────
# SECURITY: generate real secrets with `openssl rand -base64 32`. The values
# below are dev-only placeholders so a fresh checkout boots.
JWT_ACCESS_SECRET=dev-only-placeholder-generate-via-openssl-rand-base64-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-only-placeholder-generate-via-openssl-rand-base64-32
JWT_REFRESH_TTL=30d

# ── Google OAuth (leave empty until Phase 1 auth wires the provider) ────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Object storage — MinIO in dev (console http://localhost:9001),
#    S3/R2 in production ──────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=qalam-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Mail — Mailpit in dev (SMTP 1025, web UI http://localhost:8025) ─────────
SMTP_URL=smtp://localhost:1025

# ── Observability (empty disables Sentry — fine for local dev) ──────────────
SENTRY_DSN=

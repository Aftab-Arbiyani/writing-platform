# Copy to .env for local development. Values are validated at boot by src/config/env.ts.
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_ENV=development

# Public origin the app is served from — used for absolute canonical + Open Graph URLs (SEO).
# Empty → falls back to window.location.origin at runtime.
VITE_SITE_URL=

# S3/CDN base for media assets. Empty → falls back to the VITE_API_URL origin.
VITE_CDN_URL=

# PWA service-worker placeholder — 'true' to register /sw.js (off by default; no offline sync yet).
VITE_ENABLE_SW=false

# Sentry DSN. Empty → Sentry disabled.
VITE_SENTRY_DSN=

# Collaboration / publishing / trust (AF6, W3). Dark-launched OFF to match mobile's default-off
# QALAM_ENABLE_COLLABORATION, so neither client becomes reachable ahead of the other.
# A CLIENT KILL SWITCH ONLY — the server decides every read and write through the Policy Engine.
VITE_ENABLE_COLLABORATION=false

# Monetization / subscriptions / AI credits (AF5, W4). Dark-launched OFF to match mobile's
# default-off QALAM_ENABLE_MONETIZATION.
# A CLIENT KILL SWITCH ONLY — premium access is decided by the server's Entitlement Service, and
# the platform has its own `feature.payments.enabled` master flag underneath this one.
VITE_ENABLE_MONETIZATION=false

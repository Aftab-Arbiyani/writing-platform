# Copy to e2e/.env for local overrides. All values have working defaults for the
# standard dev stack (frontend :5173, admin :5174, backend :4000), so .env is optional.

# App base URLs Playwright navigates to.
E2E_BASE_URL_FRONTEND=http://localhost:5173
E2E_BASE_URL_ADMIN=http://localhost:5174

# API base the apps + the api fixture talk to.
E2E_API_URL=http://localhost:4000/api/v1

# Mailpit HTTP API (for reading verification / reset emails).
E2E_MAILPIT_URL=http://localhost:8025

# Credentials. Defaults match the e2e-fixtures + super-admin seeds (docs/e2e/03, 04).
E2E_WRITER_EMAIL=writer@qalam.local
E2E_WRITER_PASSWORD=ChangeMe!Writer1
E2E_ADMIN_EMAIL=admin@qalam.local
E2E_ADMIN_PASSWORD=ChangeMe!SuperAdmin1
